<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="24dp"/>
            
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/appToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forward Notifications"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/toggleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Enabled"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 How to Get Your Discord Webhook"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Open Discord on desktop or mobile\n2. Go to Server Settings → Integrations\n3. Click 'Webhooks' → 'New Webhook'\n4. Name it (e.g., 'Grepolis Notifications')\n5. Choose a channel\n6. Click 'Copy Webhook URL'\n7. Paste it below"
            android:textSize="12sp"
            android:textColor="#666666"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp"
            android:padding="12dp"
            android:background="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="In-Game Name (Optional)"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            
            <EditText
                android:id="@+id/nameInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="e.g., WarriorKing123"
                android:inputType="text"
                android:padding="12dp"
                android:background="#FFFFFF"/>
                
            <Button
                android:id="@+id/verifyButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verify"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        
        <TextView
            android:id="@+id/verificationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Discord Webhook URL"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/webhookInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://discord.com/api/webhooks/..."
            android:inputType="textUri"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:padding="8dp"
            android:background="#FFFFFF">

            <CheckBox
                android:id="@+id/privacyCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="I accept that notification copies will be sent to the developer for analytics and improvement"
                android:textSize="11sp"
                android:textColor="#333333"/>
        </LinearLayout>

        <TextView
            android:id="@+id/privacyLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Read Privacy Notice"
            android:textColor="#0066CC"
            android:textSize="13sp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Save Settings"
            android:textSize="15sp"
            android:padding="14dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/enableButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔔 Enable Notification Access"
            android:textSize="15sp"
            android:padding="14dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/discordLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join our Discord Community"
            android:textColor="#5865F2"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Need help? Have questions? Join us on Discord!\nGet support, share tips, and connect with other players."
            android:textSize="11sp"
            android:textColor="#666666"
            android:textAlignment="center"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thank you for using this app! 🙏"
            android:textSize="12sp"
            android:textColor="#999999"/>

    </LinearLayout>
</ScrollView>